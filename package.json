{
  "name": "hitback-backend",
  "version": "2.0.0",
  "description": "HITBACK Game Backend - Music Quiz API with Local Audio Support",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "setup": "node scripts/setup.js",
    "migrate:sessions": "node scripts/run-migration.js 002_game_session_snapshots.sql",
    "setup:audio": "node scripts/setup-audio.js",
    "health": "curl http://localhost:3000/api/health",
    "validate": "node scripts/validate-setup.js",
    "logs": "tail -f logs/hitback.log",
    "clean": "rm -rf logs/* backups/* && echo 'Cleaned logs and backups'",
    "backup": "node scripts/backup-data.js",
    "lint": "eslint server.js routes controllers middleware services utils --ext .js",
    "lint:fix": "eslint server.js routes controllers middleware services utils --ext .js --fix",
    "format": "prettier --write 'server.js' '{routes,controllers,middleware,services,utils}/**/*.js'",
    "docs": "node scripts/generate-docs.js",
    "migrate": "node scripts/migrate-tracks.js"
  },
  "keywords": [
    "music",
    "quiz",
    "game",
    "qr-code",
    "audio",
    "local",
    "express",
    "api"
  ],
  "author": "HITBACK Team",
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@babel/preset-env": "^8.0.7",
    "@types/jest": "^30.0.0",
    "babel-jest": "^30.5.2",
    "eslint": "^10.15.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "server.js",
      "routes/**/*.js",
      "controllers/**/*.js",
      "middleware/**/*.js",
      "services/**/*.js",
      "utils/**/*.js",
      "!**/*.test.js",
      "!**/__tests__/**"
    ],
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/?(*.)+(spec|test).js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(uuid)/)"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  },
  "eslintConfig": {
    "env": {
      "node": true,
      "es2021": true,
      "jest": true
    },
    "extends": [
      "eslint:recommended"
    ],
    "parserOptions": {
      "ecmaVersion": 12,
      "sourceType": "module"
    },
    "rules": {
      "no-unused-vars": "warn",
      "no-console": "off",
      "prefer-const": "error",
      "no-var": "error"
    }
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 100,
    "tabWidth": 2
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hitback-team/hitback-backend.git"
  },
  "bugs": {
    "url": "https://github.com/hitback-team/hitback-backend/issues"
  },
  "homepage": "https://github.com/hitback-team/hitback-backend#readme"
}
